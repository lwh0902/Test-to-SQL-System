# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=datacheck
# Private database egress allowlist. Comma-separated exact DNS names or CIDRs.
# Leave empty only for local development (localhost/127.0.0.1 remain allowed).
# DATAPILOT_DB_ALLOWED_HOSTS=db.company.internal,10.20.0.0/16

# LLM (also configurable via code defaults)
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
# Optional: heavier diagnosis report model (falls back to deepseek-v4-pro)
LLM_MODEL_PRO=deepseek-v4-pro

# Optional A2A outbox lease worker (background retry)
A2A_WORKER_ENABLED=false
# A2A_WORKER_ID=
# A2A_WORKER_POLL_INTERVAL=2
# A2A_WORKER_BATCH_SIZE=5
# A2A_WORKER_LEASE_SECONDS=30

# JWT
JWT_SECRET=your_jwt_secret
ACCESS_TOKEN_EXPIRE_HOURS=2
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base64 编码的随机 32 字节 AES-256-GCM 密钥（必填）
DB_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Recovery kernel / Supervisor (production defaults)
# DATAPILOT_FLAG_ANALYSIS_KERNEL=1
# Supervisor L1 flash is ON by default; set 0 only for offline/debug degrade
# DATAPILOT_SUPERVISOR_L1=1
# Auto-profile ecommerce + tech_quality mock DBs on API startup (default ON)
# DATAPILOT_AUTO_MOCK=1
# DATAPILOT_MOCK_DATABASE=datacheck
